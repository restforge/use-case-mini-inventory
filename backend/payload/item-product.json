{
    "tableName": "item_product",
    "primaryKey": "item_product_id",
    "viewQuery": "file:query/item-product-viewquery.sql",
    "fieldNameLookup": {
        "id": "item_product_id",
        "text": "product_name"
    },
    "fieldName": [
        "item_product_id",
        "product_code",
        "sku",
        "product_name",
        "category_id",
        "category_name",
        "brand",
        "description",
        "purchase_price",
        "selling_price",
        "stock",
        "min_stock",
        "uom",
        "weight",
        "is_active",
        "show_in_store",
        "barcode",
        "shelf_location",
        "notes"
    ],
    "fieldValidation": [
        {
            "name": "item_product_id",
            "type": "string",
            "constraints": {
                "primaryKey": true,
                "autoGenerate": true
            }
        },
        {
            "name": "product_code",
            "type": "string",
            "constraints": {
                "required": true,
                "maxLength": 20,
                "unique": true,
                "trim": true,
                "uppercase": true
            }
        },
        {
            "name": "selling_price",
            "type": "number",
            "constraints": {
                "required": false,
                "min": 0,
                "default": 0
            }
        },
        {
            "name": "stock",
            "type": "number",
            "constraints": {
                "required": true,
                "min": 0,
                "default": 0
            }
        },
        {
            "name": "min_stock",
            "type": "number",
            "constraints": {
                "required": false,
                "min": 0,
                "default": 0
            }
        },
        {
            "name": "weight",
            "type": "number",
            "constraints": {
                "required": false,
                "min": 0,
                "default": 0
            }
        },
        {
            "name": "uom",
            "type": "string",
            "constraints": {
                "required": false,
                "enum": ["pcs", "box", "kg"],
                "default": "pcs"
            }
        },
        {
            "name": "is_active",
            "type": "boolean",
            "constraints": {
                "required": false,
                "enum": ["true", "false"],
                "default": "true"
            }
        },
        {
            "name": "show_in_store",
            "type": "boolean",
            "constraints": {
                "required": false,
                "enum": ["true", "false"],
                "default": "true"
            }
        }    
    ],
    "datatablesQuery": "file:query/item-product-datatables.sql",
    "datatablesWhere": [
        "product_code",
        "sku",
        "product_name",                
        "all"
    ],    
    "action": {
        "datatables": true,
        "create": true,
        "update": true,
        "delete": true,
        "first": true,
        "lookup": true,
        "read": true,
        "export": false,
        "import": false,
        "adjust": false,
        "aggregate": false
    }
}