{
  "extends": "app-config.json",
  "pages": [
    {
      "pageId": "stock-outbound",
      "pageTitle": "Stock Outbound",
      "pageSubject": "Outbound",
      "pageSubtitle": "Kelola transaksi pengeluaran stok",
      "pageIcon": "exit-up",
      "apiPath": "stock-outbound",
      "primaryKey": "stock_outbound_id",
      "displayField": "outbound_number",
      "features": {
        "enableSearch": true,
        "enableStatusFilter": true,
        "statusFilter": {
          "field": "status",
          "label": "Status",
          "width": "140px",
          "options": [
            { "value": "draft", "text": "Draft" },
            { "value": "confirmed", "text": "Confirmed" },
            { "value": "cancelled", "text": "Cancelled" }
          ]
        },
        "fieldLayout": "vertical",
        "enableDataFilter": true,
        "dataFilters": [
          {
            "name": "customer_id",
            "field": "customer_id",
            "label": "Customer",
            "width": "200px",
            "display": "dropdown",
            "dataSource": {
              "type": "api",
              "resource": "customer",
              "select": ["customer_id", "customer_name"]
            }
          }
        ]
      },
      "fields": [
        {
          "name": "outbound_number",
          "label": "Outbound Number",
          "type": "text",
          "required": true,
          "inTable": true,
          "tableOrder": 1,
          "maxlength": 50,
          "placeholder": "OUT/2026/001",
          "unique": true,
          "textCase": "uppercase"
        },
        {
          "name": "outbound_date",
          "label": "Outbound Date",
          "type": "date",
          "required": true,
          "inTable": true,
          "tableOrder": 2,
          "dateFormat": "dd/mm/yyyy"
        },
        {
          "name": "warehouse_id",
          "label": "Warehouse",
          "type": "select",
          "required": true,
          "dataSource": {
            "type": "api",
            "resource": "warehouse",
            "select": ["warehouse_id", "warehouse_name"]
          }
        },
        {
          "name": "customer_id",
          "label": "Customer",
          "type": "select",
          "inTable": true,
          "tableOrder": 3,
          "tableField": "customer_name",
          "dataSource": {
            "type": "api",
            "resource": "customer",
            "select": ["customer_id", "customer_name"]
          }
        },
        {
          "name": "reference_number",
          "label": "Reference Number",
          "type": "text",
          "maxlength": 50,
          "placeholder": "SO/DO reference",
          "textCase": "uppercase"
        },
        {
          "name": "status",
          "label": "Status",
          "type": "select",
          "inTable": true,
          "tableOrder": 6,
          "defaultValue": "draft",
          "dataSource": {
            "type": "static",
            "options": [
              { "value": "draft", "text": "Draft", "badge": "badge-secondary" },
              { "value": "confirmed", "text": "Confirmed", "badge": "badge-success" },
              { "value": "cancelled", "text": "Cancelled", "badge": "badge-danger" }
            ]
          }
        },
        {
          "name": "total_items",
          "label": "Items",
          "type": "number",
          "inTable": true,
          "tableOrder": 4
        },
        {
          "name": "total_amount",
          "label": "Total Amount",
          "type": "number",
          "inTable": true,
          "tableOrder": 5,
          "format": "currency"
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "rows": 2,
          "maxlength": 500,
          "placeholder": "Additional notes..."
        }
      ],
      "fieldRows": [
        { "fields": ["outbound_number", "outbound_date"] },
        { "fields": ["warehouse_id", "customer_id"] },
        { "fields": ["reference_number", "status"] },
        { "fields": ["notes"] }
      ],
      "details": [
        {
          "detailId": "stock_outbound_item",
          "detailTitle": "Detail Items",
          "detailIcon": "package",
          "primaryKey": "stock_outbound_item_id",
          "fields": [
            {
              "name": "item_product_id",
              "label": "Product",
              "type": "select",
              "width": "250px",
              "required": true,
              "dataSource": {
                "type": "api",
                "url": "item-product/lookup",
                "select": ["item_product_id", "product_name"],
                "lookupMode": "dynamic"
              }
            },
            {
              "name": "qty_shipped",
              "label": "Qty",
              "type": "number",
              "required": true,
              "min": 1,
              "width": "90px"
            },
            {
              "name": "uom",
              "label": "UOM",
              "type": "select",
              "width": "120px",
              "dataSource": {
                "type": "static",
                "options": [
                  { "value": "pcs", "text": "Pcs" },
                  { "value": "box", "text": "Box" },
                  { "value": "kg", "text": "Kg" },
                  { "value": "liter", "text": "Liter" },
                  { "value": "meter", "text": "Meter" },
                  { "value": "pack", "text": "Pack" },
                  { "value": "set", "text": "Set" },
                  { "value": "lusin", "text": "Lusin" }
                ]
              }
            },
            {
              "name": "unit_price",
              "label": "Unit Price",
              "type": "number",
              "min": 0,
              "width": "170px",
              "format": "number"
            },
            {
              "name": "total_amount",
              "label": "Subtotal",
              "type": "number",
              "readonly": true,
              "width": "140px",
              "format": "number",
              "calculated": {
                "formula": "qty_shipped * unit_price"
              }
            },
            {
              "name": "notes",
              "label": "Notes",
              "type": "text",
              "maxlength": 200,
              "placeholder": "Item notes"
            }
          ],
          "summary": {
            "totalItems": true,
            "totalQtyField": "qty_shipped",
            "grandTotalField": "total_amount"
          }
        }
      ]
    }
  ]
}